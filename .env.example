# copy to .env if you want to override any of these. every variable is
# optional; with no .env at all the tool keeps everything under ~/.seminar-vault
# and works fully offline with no keys.

# where the database, reading library, inbox and lookup cache live. kept
# outside the repository on purpose so course pdfs can never be committed.
# VAULT_HOME=~/.seminar-vault

# individual overrides, if the defaults under VAULT_HOME do not suit
# VAULT_DB=~/.seminar-vault/vault.sqlite
# VAULT_LIBRARY=~/.seminar-vault/library
# VAULT_INBOX=~/.seminar-vault/inbox
# VAULT_CACHE=~/.seminar-vault/cache

# parse rows scoring below this go to the review queue
# VAULT_CONFIDENCE_THRESHOLD=0.75

# --- model layer, optional --------------------------------------------------
# leave unset and everything except brief generation works exactly the same.
# briefs then report "not generated" instead of failing.
# VAULT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# VAULT_LLM_MODEL=claude-sonnet-5
