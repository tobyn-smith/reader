# copy to .env and fill in. everything except DATABASE_URL is optional.

# neon or supabase pooled connection string. required for anything that touches
# the database (review commit, ingest, search, status). parsing works without it.
DATABASE_URL=postgresql://user:password@host.neon.tech/vault?sslmode=require

# where `vault ingest` looks when run with no path, and what the github action watches
VAULT_WATCH_DIR=./inbox

# on-disk cache for crossref / openlibrary lookups
VAULT_CACHE_DIR=./.cache

# rows scoring below this go to parse_review for manual confirmation
VAULT_CONFIDENCE_THRESHOLD=0.75

# --- optional model layer ---------------------------------------------------
# leave all of these unset and the tool still does everything except generate
# briefs. briefs then show as "not generated" instead of failing.
# VAULT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# VAULT_LLM_MODEL=claude-sonnet-5

# set to 1 to let tests hit crossref/openlibrary. off by default so the suite
# runs offline.
# VAULT_ALLOW_NETWORK=1
